{
  "version": 1,
  "repo": "gepet-io/gepet-squad",
  "layout": "monorepo",
  "scopes": {
    "repo": {
      "path": "."
    },
    "hooks": {
      "path": "hooks"
    },
    "viz-server": {
      "path": "viz"
    },
    "viz-web": {
      "path": "viz/public"
    },
    "skills": {
      "path": "skills/gepet-squad-viz"
    }
  },
  "branches": {
    "integration": "develop",
    "production": "main"
  },
  "maxParallelDevs": 3,
  "maxRetries": 3,
  "graphify": {
    "enabled": true
  },
  "ci": {
    "mode": "local",
    "commands": [
      "npm ci",
      "npm run lint",
      "npm test",
      "bash -n scripts/bootstrap.sh",
      "bash -n scripts/vendor-three.sh",
      "bash -n scripts/vendor-assets.sh"
    ]
  }
}
